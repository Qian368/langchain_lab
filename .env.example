# ============ 环境变量示例 ============
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交入库）
# yaml 里的 ${VAR} 占位会由 env_expand 在配置加载期展开，读取这里的值

# ---- RAG MongoDB 用户侧连接串（yaml: rag.mongo.user_uri 占位 ${MONGO_USER_URI}）----
MONGO_USER_URI=mongodb://app_user:YOUR_PASSWORD@localhost:27017/knowledge_base?authSource=knowledge_base

# ---- RAG MongoDB 运维管理员连接串（yaml: rag.mongo.admin_uri 占位 ${MONGO_ADMIN_URI}）----
MONGO_ADMIN_URI=mongodb://root:YOUR_ADMIN_PASSWORD@localhost:27017/?authSource=admin

# ---- LLM API Key（yaml: config/llm.yaml 占位 ${...}）----
# 按你 llm.yaml 里占位名填，例如：
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
